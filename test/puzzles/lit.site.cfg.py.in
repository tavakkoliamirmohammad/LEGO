@LIT_SITE_CFG_IN_HEADER@

import sys

config.python_executable = "@Python_EXECUTABLE@"
config.pythonpath = "@LEGO_PYTHONPATH@"
config.mlir_build_dir = "@_MLIR_BUILD_DIR@"
config.puzzles_dir = "@CMAKE_SOURCE_DIR@/python/examples/puzzles"
config.lego_obj_root = "@LEGO_BINARY_DIR@"
config.host_has_nvidia_gpu = @LEGO_HOST_HAS_NVIDIA_GPU@
config.host_has_amd_gpu = @LEGO_HOST_HAS_AMD_GPU@
config.host_has_metal = @LEGO_HOST_HAS_METAL@
config.enable_cuda_runner = @LEGO_ENABLE_CUDA_RUNNER@
config.enable_rocm_runner = @LEGO_ENABLE_ROCM_RUNNER@
config.enable_metal_runner = @LEGO_ENABLE_METAL_RUNNER@

import lit.llvm
lit.llvm.initialize(lit_config, config)

# Let the main config do the real work.
lit_config.load_config(config, "@LEGO_SOURCE_DIR@/test/puzzles/lit.cfg.py")
